rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Any signed-in user (including anonymous auth) can read/write a family's
    // data as long as they know the family code, which acts as a shared
    // secret. There is no per-user ownership check because this app is
    // designed for a single family sharing one code across devices.
    match /families/{familyCode}/characters/{characterId} {
      allow read, write: if request.auth != null;
    }
  }
}
